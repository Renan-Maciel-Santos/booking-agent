# Copy to .env and adjust. NEVER commit the real .env file.

# --- Application
APP_NAME=booking-agent
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (also consumed by the postgres container)
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Tuning
DB_HEALTH_TIMEOUT_SECONDS=2.0
DB_POOL_SIZE=5

# --- Booking Business Rules
BUSINESS_TIMEZONE=America/Sao_Paulo
SLOT_GRANULARITY_MINUTES=15
MIN_BOOKING_ADVANCE_MINUTES=60
MAX_BOOKING_HORIZON_DAYS=30

# --- Host ports used by docker-compose
# Publish the API only on the host loopback interface by default.
# Use 0.0.0.0 only when another host or container needs to reach the API
# (e.g., n8n running on another machine) and understand that this exposes it on the network.
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=8000
POSTGRES_HOST_PORT=5432  # Only used when running with docker-compose.dev.yml

# --- LLM (use 'fake' for offline demo/dev without API keys, 'openai' for production)
LLM_PROVIDER=fake
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# --- Webhook Authentication & Rate Limiting
WEBHOOK_SECRET=change-me-to-a-secure-random-secret
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# MAX_BODY_BYTES=65536
# MAX_TEXT_LENGTH=1000
# RATE_LIMIT_REQUESTS_PER_MINUTE=10
# REQUEST_TIMEOUT_SECONDS=15.0

# --- Personal Data Retention Policy
# Days before stored response texts in processed_messages are redacted to NULL (keeps message_id for deduplication)
PROCESSED_MESSAGE_REDACT_AFTER_DAYS=7
# Days before processed_messages rows are permanently deleted (must be greater than redact after days)
PROCESSED_MESSAGE_DELETE_AFTER_DAYS=90
# Days of inactivity before abandoned conversation_states are deleted (must be greater than conversation TTL)
CONVERSATION_STATE_DELETE_AFTER_DAYS=30
# Batch size for retention purge queries to avoid long table locks
RETENTION_BATCH_SIZE=1000
